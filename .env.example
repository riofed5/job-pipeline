# Chép thành .env (đã trong .gitignore). Không có file này thì app vẫn chạy, chỉ không kéo email.

# Gmail: bật 2FA → tạo App Password. KHÔNG dùng mật khẩu thật.
IMAP_USER=you@gmail.com
IMAP_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Label/folder chứa mail alert (Gmail filter: from chứa domain board → gắn label này)
IMAP_LABEL=jobalerts
# IMAP_HOST=imap.gmail.com

# Parser email dùng Claude. Chỉ trích xuất, không quyết định.
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5
